# Copy to .env for local development: cp .env.example .env
# Never commit .env. Secrets come from the environment and a secrets manager
# only (DEV_PLAN.global_engineering_rules).

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL from docker-compose.yml (port shifted to avoid collisions)
DATABASE_URL="postgresql://devora:devora@localhost:5433/devora?schema=public"
# Throwaway database used by `prisma migrate dev` to diff the schema
SHADOW_DATABASE_URL="postgresql://devora:devora@localhost:5433/devora_shadow?schema=public"
# Integration tests truncate this one between tests
TEST_DATABASE_URL="postgresql://devora:devora@localhost:5433/devora_test?schema=public"

# Redis from docker-compose.yml
REDIS_URL="redis://localhost:6380"

# API
API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN="http://localhost:3000"
# Generate your own: openssl rand -base64 48
SESSION_SECRET="change-me-locally-at-least-32-bytes-of-entropy"

# Worker
WORKER_CONCURRENCY=5

# Mock provider server (tools/mocks). Real vendors are chosen by ADR and are a
# human gate: nothing here points at a paid service.
MOCK_SERVER_PORT=4010
FULLENRICH_BASE_URL="http://localhost:4010/fullenrich"
TELEPHONY_BASE_URL="http://localhost:4010/telephony"
TRANSCRIPTION_BASE_URL="http://localhost:4010/transcription"
EMAIL_BASE_URL="http://localhost:4010/email"
CALENDAR_BASE_URL="http://localhost:4010/calendar"

# Provider credentials: leave empty locally, the mocks need none.
FULLENRICH_API_KEY=""
ANTHROPIC_API_KEY=""

NEXT_TELEMETRY_DISABLED=1

# Playwright: set only when the machine has a pre-installed Chromium whose
# build does not match this Playwright version (some CI sandboxes do).
# PLAYWRIGHT_CHROMIUM_PATH="/opt/pw-browsers/chromium-1194/chrome-linux/chrome"
