# dependencies
node_modules/
.pnpm-store/

# build output
dist/
# Scoped deliberately: a bare `build/` would also swallow docs/build, which
# holds the build tracker, the roadmap and the phase reports.
/build/
apps/*/build/
packages/*/build/
.next/
out/
*.tsbuildinfo
.turbo/
# Prisma generates its client into packages/db/generated: build output, and it
# is regenerated by `pnpm --filter @devora/db run generate`.
generated/

# test + tooling output
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# environment: never commit real credentials (DEV_PLAN global_engineering_rules)
.env
.env.*
!.env.example

# local database volumes
.docker-data/

# editor + OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
