{
  "name": "@devora/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Devora Sales Engine HTTP API.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@devora/compliance": "workspace:*",
    "@devora/contracts": "workspace:*",
    "@devora/db": "workspace:*",
    "@devora/domain": "workspace:*",
    "@devora/integrations": "workspace:*",
    "@devora/script-engine": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "fastify": "5.12.5",
    "pino": "10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pino-pretty": "13.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
