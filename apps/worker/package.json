{
  "name": "@devora/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Jobs, webhook processing, schedulers and SLA timers.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
