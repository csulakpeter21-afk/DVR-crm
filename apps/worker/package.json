    "@devora/domain": "workspace:*",
    "@devora/integrations": "workspace:*",
    "bullmq": "6.3.12",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pino-pretty": "13.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
