    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@devora/contracts": "workspace:*",
    "fastify": "5.12.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
