{
  "name": "@devora/mocks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mock servers for FullEnrich, telephony, transcription, email and calendar.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
